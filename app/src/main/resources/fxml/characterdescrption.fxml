<VBox alignment="CENTER" prefHeight="741.0" prefWidth="1024.0" spacing="18.0" stylesheets="@../style/start.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg126599.controller.CharacterDescriptionController">
    <padding>
        <Insets bottom="40.0" left="70.0" right="70.0" top="40.0" />
    </padding>
    <children>
        <Label fx:id="nameLabel" styleClass="title" text="PERSONAGGIO" />
        <Label fx:id="physicalLabel" styleClass="subtitle" wrapText="true" />
        <Label fx:id="mentalLabel" styleClass="subtitle" wrapText="true" />
        <Label fx:id="abilityLabel" styleClass="subtitle" wrapText="true" />
        <Button fx:id="continueButton" onAction="#onContinue" prefHeight="42.0" prefWidth="220.0" text="Continua" />
    </children>
</VBox>